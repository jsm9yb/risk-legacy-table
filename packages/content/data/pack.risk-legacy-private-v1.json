    "ownHqCountsAsRedStar": {
      "value": true,
      "verification": "confirmed",
      "note": "Every HQ a player CONTROLS counts as 1 board Red Star. An HQ territory with 0 troops is controlled by nobody."
    },
    "legalStartRule": {
      "value": "unoccupied_unmarked_or_own_founded_major_city",
      "verification": "confirmed",
      "note": "Unoccupied unmarked territory, or unoccupied Major City founded by that player (even if scarred). Minor cities never qualify. Engine: major-city allowance activates with the city-founding slice."
    },
    "initialHqAdjacencyRule": {
      "value": "no_adjacent_enemy_hq",
      "verification": "confirmed",
      "note": "Initial HQ placement cannot be adjacent to another faction HQ. Enforced in engine."
    },
    "joinWarLegalStartRule": {
      "value": "same_as_start_no_hq",
      "verification": "confirmed",
      "note": "Same legal territory rule as starting placement, but no HQ is placed; HQ-adjacency only applies when placing an HQ."
    },
    "joinWarTroops": {
      "value": "half_starting_total",
      "verification": "confirmed",
      "note": "Half the starting troop total (=4 with starter rules). No HQ placed."
    },
    "cityResistanceOnExpand": {
      "value": "population_plus_fortify",
      "verification": "confirmed",
      "note": "Expanding into an unoccupied city costs troops = population (Minor 1, Major 2, World Capital 5); fortified +2. Attacking enemy troops in a city pays no resistance."
    },
    "minRecruit": {
      "value": 3,
      "verification": "confirmed"
    },
    "territoriesPerTroop": {
      "value": 3,
      "verification": "confirmed"
    },
    "recruitCountsPopulationInDivision": {
      "value": true,
      "verification": "confirmed",
      "note": "Recruit = max(floor((territories + city population) / 3), minRecruit) + bonuses. Population is INSIDE the division (rulebook; also implied by round_up_recruiting in SPEC section 6). Corrected 2026-07-06 - previously population was added at face value."
    },
