      },
      "verification": "confirmed",
      "text": "Pack 1 scar. At the controller's end of turn (before the draw), lose 1 troop from this territory; vacate if it was the last."
    },
    {
      "id": "mercenary",
      "name": "Mercenary",
      "target": "territory",
      "handler": "onEndTurn",
      "source": "pack2",
      "starterPlayable": false,
      "instances": 3,
      "effect": {
        "trigger": "controller_end_turn",
        "op": "add_troops",
        "amount": 1
      },
      "verification": "confirmed",
      "text": "Pack 2 scar. At the controller's end of turn, gain 1 troop if still controlled. Playable once Pack 2 unlocks (SPEC section 5, confirmed)."
    },
    {
      "id": "fortification",
      "name": "Fortification",
      "target": "territory",
      "handler": "modifyCombatDie",
      "source": "reward",
      "starterPlayable": false,
      "durability": 10,
      "effect": {
        "side": "def",
        "op": "add",
        "amount": 1,
        "applyTo": "each_die",
        "expandSurcharge": 2,
        "markDurabilityWhenAttackersEquals": 3,
        "cityOnly": true,
        "refortifyReplaces": true
      },
      "verification": "confirmed",
      "text": "Not a scar card — a winner reward mark (fortify_city) on a city. Defender adds +1 to EACH defense die. Expanding into the unoccupied fortified city costs +2 troops. Mark 1 durability box after each attack roll made with 3 attacking troops; after 10 boxes the city is no longer fortified. Re-fortifying replaces remaining durability."
    }
  ],
