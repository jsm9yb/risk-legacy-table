  "powers": [
    {
      "id": "fortified_hq",
      "name": "Fortified HQ",
      "handler": "modifyCombatDie",
      "text": "Die Mechaniker's starting HQ is fortified when Die Mechaniker defends it: +1 to each defense die, no durability boxes, no expansion surcharge; does not stack with the Fortification reward mark.",
      "verification": "confirmed"
    },
    {
      "id": "defensive_stand",
      "name": "Defensive Stand",
      "handler": "modifyCombatDie",
      "text": "If Die Mechaniker's natural defense roll is two 6s, the defended territory cannot be attacked again for the rest of the active turn.",
      "verification": "confirmed"
    },
    {
      "id": "lower_die_intimidation",
      "name": "Intimidation",
      "handler": "modifyCombatDie",
      "text": "Defender subtracts 1 from the LOWER defense die in the first territory Enclave of the Bear attacks each turn, for as long as Enclave keeps attacking that same territory.",
      "verification": "confirmed"
    },
    {
      "id": "total_conquest",
      "name": "Total Conquest",
      "handler": "modifyCombatDie",
      "text": "If Enclave of the Bear's natural attack roll is three of a kind and the final combat would kill at least one defender, remove ALL defenders and conquer normally.",
      "verification": "confirmed"
    },
    {
      "id": "round_up_recruiting",
      "name": "Round-Up Recruiting",
      "handler": "alterRecruitment",
      "text": "Round UP (instead of down) only the (territories + population) / 3 recruitment component, before minimum-recruit and bonuses.",
      "verification": "confirmed"
    },
    {
      "id": "expansionist_supply",
      "name": "Expansionist Supply",
      "handler": "alterRecruitment",
      "effect": { "expandThreshold": 4 },
      "text": "If Imperial Balkania expands into 4 or more unoccupied territories this turn, it may draw a Resource card at end of turn even without an enemy conquest.",
      "verification": "confirmed"
    },
    {
      "id": "hq_reinforcement",
      "name": "HQ Reinforcement",
      "handler": "alterRecruitment",
      "text": "At the start of Khan Industries' turn, add 1 troop to each territory Khan controls that contains any HQ.",
      "verification": "confirmed"
    },
    {
      "id": "territory_card_reinforcement",
      "name": "Territory Card Reinforcement",
      "handler": "alterRecruitment",
      "text": "After drawing a Territory card, if Khan Industries controls that territory, it may add 1 troop there.",
      "verification": "confirmed"
    },
    {
      "id": "early_maneuver",
      "name": "Early Maneuver",
      "handler": "extraManeuver",
      "text": "Saharan Republic's one maneuver may be taken at any stable point during its own turn, not just the maneuver phase.",
      "verification": "confirmed"
    },
    {
      "id": "unconnected_maneuver",
      "name": "Unconnected Maneuver",
      "handler": "extraManeuver",
      "text": "Normal maneuver timing, but the source and target territories need only be controlled by Saharan Republic, not connected.",
      "verification": "confirmed"
    }
  ],
