# Local LAN deployment (Mac mini host). Use direct IPv4 because .local may resolve to IPv6 from Windows.
DATABASE_URL=postgres://risk:risk@192.168.86.21:5432/risk_legacy
PORT=8787
# Comma-separated origins allowed for the web app
CORS_ORIGINS=http://localhost:5173,http://192.168.86.21:5173
# Directory for automatic campaign export JSON backups
BACKUP_DIR=./backups
